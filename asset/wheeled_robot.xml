<mujoco model="wheeled_legged_robot">
  <compiler angle="radian" />

  <!-- 强化学习推荐配置：更小的时间步长，确立重力 -->
  <option timestep="0.002" gravity="0 0 -9.81" />
  <visual>
    <rgba haze="0.4 0.6 0.8 1" />
  </visual>

  <asset>
    <!-- 这里保持你原本的网格路径不变 -->
    <mesh name="base_link" content_type="model/stl" file="meshes/base_link.STL" />
    <mesh name="left_leg" content_type="model/stl" file="meshes/left_leg.STL" />
    <mesh name="left_foot" content_type="model/stl" file="meshes/left_foot.STL" />
    <mesh name="left_wheel" content_type="model/stl" file="meshes/left_wheel.STL" />
    <mesh name="right_leg" content_type="model/stl" file="meshes/right_leg.STL" />
    <mesh name="right_foot" content_type="model/stl" file="meshes/right_foot.STL" />
    <mesh name="right_wheel" content_type="model/stl" file="meshes/right_wheel.STL" />
    <!-- 新增：蓝天天穹 -->
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0 0 0" width="512"
      height="512" />
    <!-- 新增：经典的深蓝/浅蓝交替的棋盘格纹理 -->
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2"
      width="512" height="512" mark="cross" markrgb="0.8 0.8 0.8" />

    <!-- 新增：创建一个包含一点反射(reflectance)的地板材质 -->
    <material name="matplane" reflectance="0.2" texture="texplane" texrepeat="1 1" texuniform="true" />
  </asset>

  <worldbody>
    <!-- 1. 添加灯光和地板 -->
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <!-- 修改地板：将 type="plane" 绑定到 matplane，size 最后的 1 代表格子大小为 1x1 米 -->
    <geom name="floor" type="plane" size="0 0 1" material="matplane" condim="3" />

    <body name="base_link" pos="0 0 0.5">
      <!--<freejoint
      name="root"/>-->
      <geom name="base_link_visual" type="mesh" rgba="0.79216 0.81961 0.93333 1" mesh="base_link"
        contype="0" conaffinity="0" group="1" />
      <geom name="base_link_collision" type="box" size="0.138 0.053 0.025" rgba="0 0.8 0.2 0.25"
        group="3" />

      <!-- 以下子节点层级与原先完全一致，只是整体缩进到了 base_link 内部 -->
      <body name="left_leg" pos="-0.1148 0 -0.04075" quat="0.499998 0.5 -0.500002 -0.5">
        <inertial pos="0.014085 -0.086343 -0.017864" quat="0.704744 0.699928 0.079862 0.084017"
          mass="0.11866" diaginertia="0.00022805 0.000205989 3.64827e-05" />
        <joint name="servo2" pos="0 0 0" axis="0 0 1" range="-1.57 1.57" actuatorfrcrange="-5 5"
          damping="0.1" armature="0.01" />
        <geom name="left_leg_visual" type="mesh" rgba="0.79216 0.81961 0.93333 1" mesh="left_leg"
          contype="0" conaffinity="0" group="1" />
        <geom name="left_leg_collision" type="capsule" fromto="0.016 -0.09 -0.02 -0.006 -0.01 -0.02"
          size="0.027" rgba="0 0.8 0.2 0.25" group="3" />
        <body name="left_foot" pos="0.0002967 -0.14 0">
          <inertial pos="-0.00038874 -0.06993 -0.0060741"
            quat="0.747777 0.663944 -0.00184553 -0.00207827" mass="0.057726"
            diaginertia="0.000135864 0.000131727 9.16446e-06" />
          <joint name="servo1" pos="0 0 0" axis="0 0 1" range="-3.14 0" actuatorfrcrange="-5 5"
            damping="0.1" armature="0.01" />
          <geom name="left_foot_visual" type="mesh" rgba="0.79216 0.81961 0.93333 1" mesh="left_foot"
            contype="0" conaffinity="0" group="1" />
          <geom name="left_foot_collision" type="capsule" fromto="0.000 -0.05 0 0.0 0.00 -0.02"
            size="0.021" rgba="0 0.8 0.2 0.25" group="3" />
          <body name="left_wheel" pos="-0.00077824 -0.14 -0.00275" quat="-3.67321e-06 0 0 1">
            <inertial pos="-0.00048154 -0.00095238 0.036709" quat="0.5 0.5 -0.5 0.5" mass="0.43394"
              diaginertia="0.001247 0.000686 0.000686" />
            <joint name="wheel1" pos="0 0 0" axis="0 0 1" damping="0.02" armature="0.01" />
            <geom name="left_wheel_visual" type="mesh" rgba="0.79216 0.81961 0.93333 1" mesh="left_wheel"
              contype="0" conaffinity="0" group="1" />
            <geom name="left_wheel_collision" type="cylinder" pos="0.0 0.0 0.03" size="0.0625 0.035" rgba="0 0.8 0.2 0.25"
              group="3" />
          </body>
        </body>
      </body>

      <body name="right_leg" pos="0.1148 0 -0.04075" quat="0.499998 0.5 0.500002 0.5">
        <inertial pos="-0.014085 -0.086343 -0.017864" quat="0.704744 0.699928 -0.079862 -0.084017"
          mass="0.11866" diaginertia="0.00022805 0.000205989 3.64827e-05" />
        <joint name="servo4" pos="0 0 0" axis="0 0 -1" range="-1.57 1.57" actuatorfrcrange="-5 5"
          damping="0.1" armature="0.01" />
        <geom name="right_leg_visual" type="mesh" rgba="1 1 1 1" mesh="right_leg" contype="0"
          conaffinity="0" group="1" />
        <geom name="right_leg_collision" type="capsule" fromto="-0.016 -0.09 -0.02 0.006 -0.01 -0.02"
          size="0.027" rgba="0 0.8 0.2 0.25" group="3" />
        <body name="right_foot" pos="-0.0002967 -0.14 0">
          <inertial pos="0.00038874 -0.06993 -0.0060741"
            quat="0.747777 0.663944 0.00184553 0.00207827" mass="0.057726"
            diaginertia="0.000135864 0.000131727 9.16446e-06" />
          <joint name="servo3" pos="0 0 0" axis="0 0 -1" range="-3.14 0" actuatorfrcrange="-5 5"
            damping="0.1" armature="0.01" />
          <geom name="right_foot_visual" type="mesh" rgba="0.79216 0.81961 0.93333 1" mesh="right_foot"
            contype="0" conaffinity="0" group="1" />
          <geom name="right_foot_collision" type="capsule" fromto="0 0.001 -0.075 0 0.001 0.090"
            size="0.021" rgba="0 0.8 0.2 0.25" group="3" />
          <body name="right_wheel" pos="0.00077824 -0.14 -0.00275">
            <inertial pos="-0.00048154 0.00095238 0.036709" quat="0.5 0.5 -0.5 0.5" mass="0.43394"
              diaginertia="0.00124706 0.00068649 0.00068643" />
            <joint name="wheel2" pos="0 0 0" axis="0 0 -1" damping="0.02" armature="0.01" />
            <geom name="right_wheel_visual" type="mesh" rgba="0.94118 0.67451 0.11765 1" mesh="right_wheel"
              contype="0" conaffinity="0" group="1" />
            <geom name="right_wheel_collision" type="cylinder" size="0.0625 0.0265"
              rgba="0 0.8 0.2 0.25" group="3" />
          </body>
        </body>
      </body>
    </body> <!--
    结束 base_link -->
  </worldbody>

  <contact>
    <exclude body1="base_link" body2="left_leg" />
    <exclude body1="base_link" body2="right_leg" />
    <exclude body1="left_leg" body2="right_leg" />
    <exclude body1="left_leg" body2="left_foot" />
    <exclude body1="right_leg" body2="right_foot" />
    <exclude body1="left_foot" body2="left_wheel" />
    <exclude body1="right_foot" body2="right_wheel" />
  </contact>

  <!-- 3. 定义 RL 的动作空间 -->
  <actuator>
    <!-- 腿部伺服电机：位置控制 -->
    <!-- kp 是位置环的比例增益（刚度）。你可以根据真实舵机的参数调大或调小 -->
    <!-- ctrlrange 设置为与对应关节的物理限位 (range) 保持一致 -->
    <position name="pos_servo2" joint="servo2" ctrllimited="true" ctrlrange="-1.57 1.57" kp="10"
      kv="2" forcerange="-2 2" />
    <position name="pos_servo1" joint="servo1" ctrllimited="true" ctrlrange="-3.14 0" kp="10" kv="2"
      forcerange="-2 2" />
    <position name="pos_servo4" joint="servo4" ctrllimited="true" ctrlrange="-1.57 1.57" kp="10"
      kv="2" forcerange="-2 2" />
    <position name="pos_servo3" joint="servo3" ctrllimited="true" ctrlrange="-3.14 0" kp="10" kv="2"
      forcerange="-2 2" />
    <!-- 轮毂电机：速度控制 -->
    <!-- kv 是速度环的增益。ctrlrange 代表你期望的最大角速度 (rad/s) -->
    <velocity name="vel_wheel1" joint="wheel1" ctrllimited="true" ctrlrange="-20 20" kv="2" />
    <velocity name="vel_wheel2" joint="wheel2" ctrllimited="true" ctrlrange="-20 20" kv="2" />
  </actuator>

</mujoco>
