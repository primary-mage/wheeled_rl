#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "wheeled_legged_robot"
    doc = """Generated from Composed Stage of root layer /tmp/tmp7hsoxo5v/wheeled_legged_robot.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_wheeled_robot_tdtqn7ne/usdex_wheeled_robot/wheeled_legged_robot.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_wheeled_robot_tdtqn7ne/temp_wheeled_robot/wheeled_robot.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "wheeled_legged_robot"
{
    over "Geometry"
    {
        over "base_link"
        {
            over "left_leg"
            {
                over "left_foot"
                {
                    over "left_wheel"
                    {
                        over "wheel1" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:armature = 0.01
                        }
                    }

                    over "servo1" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.01
                    }
                }

                over "servo2" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.01
                }
            }

            over "right_leg"
            {
                over "right_foot"
                {
                    over "right_wheel"
                    {
                        over "wheel2" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:armature = 0.01
                        }
                    }

                    over "servo3" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.01
                    }
                }

                over "servo4" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.01
                }
            }
        }
    }
}

