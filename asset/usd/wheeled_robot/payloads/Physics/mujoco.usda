#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "wheeled_legged_robot"
    doc = """Generated from Composed Stage of root layer /tmp/tmps__jrbmd/wheeled_legged_robot.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_wheeled_robot_k4t8x46d/usdex_wheeled_robot/wheeled_legged_robot.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_wheeled_robot_k4t8x46d/temp_wheeled_robot/wheeled_robot.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "wheeled_legged_robot"
{
    over "Geometry"
    {
        over "base_link"
        {
            over "base_link_collision" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 3
            }

            over "left_leg"
            {
                over "left_leg_collision" (
                    prepend apiSchemas = ["MjcCollisionAPI"]
                )
                {
                    uniform int mjc:group = 3
                }

                over "left_foot"
                {
                    over "left_foot_collision" (
                        prepend apiSchemas = ["MjcCollisionAPI"]
                    )
                    {
                        uniform int mjc:group = 3
                    }

                    over "left_wheel"
                    {
                        over "left_wheel_collision" (
                            prepend apiSchemas = ["MjcCollisionAPI"]
                        )
                        {
                            uniform int mjc:group = 3
                        }

                        over "wheel1" (
                            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                            prepend apiSchemas = ["MjcJointAPI"]
                        )
                        {
                            uniform double mjc:armature = 0.01
                            uniform double mjc:damping = 0.02
                        }

                        over "left_wheel_visual"
                        {
                        }
                    }

                    over "servo1" (
                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        prepend apiSchemas = ["MjcJointAPI"]
                    )
                    {
                        uniform double mjc:actuatorfrcrange:max = 5
                        uniform double mjc:actuatorfrcrange:min = -5
                        uniform double mjc:armature = 0.01
                        uniform double mjc:damping = 0.1
                    }

                    over "left_foot_visual"
                    {
                    }
                }

                over "servo2" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                    uniform double mjc:actuatorfrcrange:max = 5
                    uniform double mjc:actuatorfrcrange:min = -5
                    uniform double mjc:armature = 0.01
                    uniform double mjc:damping = 0.1
                }

                over "left_leg_visual"
                {
                }
            }

            over "right_leg"
            {
                over "right_leg_collision" (
                    prepend apiSchemas = ["MjcCollisionAPI"]
                )
                {
                    uniform int mjc:group = 3
                }

                over "right_foot"
                {
                    over "right_foot_collision" (
                        prepend apiSchemas = ["MjcCollisionAPI"]
                    )
                    {
                        uniform int mjc:group = 3
                    }

                    over "right_wheel"
                    {
                        over "right_wheel_collision" (
                            prepend apiSchemas = ["MjcCollisionAPI"]
                        )
                        {
                            uniform int mjc:group = 3
                        }

                        over "wheel2" (
                            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                            prepend apiSchemas = ["MjcJointAPI"]
                        )
                        {
                            uniform double mjc:armature = 0.01
                            uniform double mjc:damping = 0.02
                        }

                        over "right_wheel_visual"
                        {
                        }
                    }

                    over "servo3" (
                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        prepend apiSchemas = ["MjcJointAPI"]
                    )
                    {
                        uniform double mjc:actuatorfrcrange:max = 5
                        uniform double mjc:actuatorfrcrange:min = -5
                        uniform double mjc:armature = 0.01
                        uniform double mjc:damping = 0.1
                    }

                    over "right_foot_visual"
                    {
                    }
                }

                over "servo4" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                    uniform double mjc:actuatorfrcrange:max = 5
                    uniform double mjc:actuatorfrcrange:min = -5
                    uniform double mjc:armature = 0.01
                    uniform double mjc:damping = 0.1
                }

                over "right_leg_visual"
                {
                }
            }

            over "base_link_visual"
            {
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial" (
            prepend apiSchemas = ["MjcMaterialAPI"]
        )
        {
        }

        def MjcActuator "pos_servo2"
        {
            uniform double[] mjc:biasPrm = [0, -10, -2, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 1.57
            uniform double mjc:ctrlRange:min = -1.57
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            uniform double[] mjc:gainPrm = [10, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            custom rel mjc:target
            prepend rel mjc:target = </wheeled_legged_robot/Geometry/base_link/left_leg/servo2>
        }

        def MjcActuator "pos_servo1"
        {
            uniform double[] mjc:biasPrm = [0, -10, -2, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -3.14
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            uniform double[] mjc:gainPrm = [10, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            custom rel mjc:target
            prepend rel mjc:target = </wheeled_legged_robot/Geometry/base_link/left_leg/left_foot/servo1>
        }

        def MjcActuator "pos_servo4"
        {
            uniform double[] mjc:biasPrm = [0, -10, -2, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 1.57
            uniform double mjc:ctrlRange:min = -1.57
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            uniform double[] mjc:gainPrm = [10, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            custom rel mjc:target
            prepend rel mjc:target = </wheeled_legged_robot/Geometry/base_link/right_leg/servo4>
        }

        def MjcActuator "pos_servo3"
        {
            uniform double[] mjc:biasPrm = [0, -10, -2, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -3.14
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            uniform double[] mjc:gainPrm = [10, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            custom rel mjc:target
            prepend rel mjc:target = </wheeled_legged_robot/Geometry/base_link/right_leg/right_foot/servo3>
        }

        def MjcActuator "vel_wheel1"
        {
            uniform double[] mjc:biasPrm = [0, 0, -2, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 20
            uniform double mjc:ctrlRange:min = -20
            uniform double[] mjc:gainPrm = [2, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            custom rel mjc:target
            prepend rel mjc:target = </wheeled_legged_robot/Geometry/base_link/left_leg/left_foot/left_wheel/wheel1>
        }

        def MjcActuator "vel_wheel2"
        {
            uniform double[] mjc:biasPrm = [0, 0, -2, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 20
            uniform double mjc:ctrlRange:min = -20
            uniform double[] mjc:gainPrm = [2, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            custom rel mjc:target
            prepend rel mjc:target = </wheeled_legged_robot/Geometry/base_link/right_leg/right_foot/right_wheel/wheel2>
        }
    }

    over "Materials"
    {
    }
}

